# Project One Get-Item Pseudocode
# This process runs inside the main game loop for a get command.

START get_item
    RECEIVE current_room, inventory, and player_command
    SET requested_item TO the text after "get "
    SET room_item TO the uncollected item in current_room, if one exists

    IF requested_item IS empty
        OUTPUT "Enter an item name after get."
    ELSE IF room_item exists AND requested_item matches room_item
        ADD room_item TO inventory
        REMOVE room_item FROM current_room
        OUTPUT "You collected " + requested_item
        OUTPUT inventory
    ELSE
        OUTPUT "That item is not available in this room."
    END IF

    RETURN TO main game loop to ask for the next command
END get_item

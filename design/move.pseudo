# Project One Move-Between-Rooms Pseudocode
# The Forgotten Grimoire: Secrets of the Arcane Tower
# Current room begins at Main Gate; room exits are stored in the game map.

START GAME
SET current_room TO "Main Gate"
SET inventory TO empty list
SET game_running TO TRUE

WHILE game_running IS TRUE
    OUTPUT current_room AND inventory
    OUTPUT "Enter a command: go <direction> or get <item>."
    INPUT player_command

    IF player_command starts with "go "
        SET direction TO the text after "go "

        IF direction IS NOT north, south, east, or west
            OUTPUT "Invalid direction. Use north, south, east, or west."

        ELSE IF direction IS NOT an available exit from current_room
            OUTPUT "You cannot go that way."

        ELSE
            SET current_room TO the room connected by direction
            OUTPUT "You entered " + current_room

            IF current_room IS "Hollow Sanctum"
                IF inventory contains all six required artifacts
                    OUTPUT "You defeated the Hollow Archmage and recovered the Forgotten Grimoire. You win!"
                ELSE
                    OUTPUT "The Hollow Archmage defeats you. Game over."
                END IF

                SET game_running TO FALSE
            END IF
        END IF

    ELSE IF player_command starts with "get "
        PERFORM get-item process using current_room, inventory, and player_command

    ELSE
        OUTPUT "Invalid command. Use go <direction> or get <item>."
    END IF
END WHILE

END GAME